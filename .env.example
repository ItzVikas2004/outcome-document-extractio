# Optional: Compose starts without an .env file.
DATABASE_URL=postgresql+psycopg://outcome@postgres:5432/outcome
LOG_LEVEL=INFO
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_LEASE_SECONDS=30
WORKER_HEARTBEAT_SECONDS=5
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_SECONDS=2
UPLOAD_DIR=uploads
# Set the assigned gateway and key at runtime; no endpoint/key fallback exists.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=google/gemini-3.8-flash
LLM_MAX_INPUT_TOKENS=16000
LLM_MAX_OUTPUT_TOKENS=8192
LLM_TOTAL_INPUT_BUDGET=500000
LLM_MAX_CALLS=64
LLM_TRANSPORT_RETRIES=2
LLM_REPAIR_RETRIES=1
LLM_TIMEOUT_SECONDS=45
# Optional rates for this configured model. Blank means cost is unknown unless reported.
LLM_INPUT_PRICE_PER_MILLION=
LLM_OUTPUT_PRICE_PER_MILLION=
